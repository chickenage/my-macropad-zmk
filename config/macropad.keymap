#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Config 1";
            bindings = <
                &kp A     &kp B     &kp C     &kp D
            >;
        };

        layer_1 {
            display-name = "Config 2";
            bindings = <
                &kp D     &kp E     &kp F     &to 2
            >;
        };

        layer_2 {
            display-name = "Config 3";
            bindings = <
                &kp G     &kp H     &kp I     &to 0
            >;
        };
    };
};
